public class Largest{
    public static int largestElement(int [] element ){

int largest = element[0];

for(int num = 1; num < element.length; num++){

if(element[num] < largest){
largest = element[num];
}
return largest;
}

}

public static void main(String[] args){
 
System.out.print(largestElement(new int [] {12,211,21,343,3246,674,15}));

}

}
